# Your Algorand address that RECEIVES payments (e.g. a Pera account).
# It must be opted in to USDC (asset 31566704 on MainNet, 10458941 on TestNet).
PAY_TO_ADDRESS=

# Optional: an EVM (Base) address to ALSO accept USDC on Base. Leave empty for Algorand only.
BASE_PAY_TO_ADDRESS=

# "testnet" while testing, then "mainnet" for the contest.
NETWORK=testnet

# Free key from https://www.eia.gov/opendata/register.php (DEMO_KEY works but is rate-limited)
EIA_API_KEY=

# Your public HTTPS address once the Cloudflare Tunnel is running (no trailing slash)
PUBLIC_URL=

PORT=4021
FACILITATOR_URL=https://facilitator.goplausible.xyz

# --- Only for `npm run pay` (testing as a buyer) ---
# 25-word recovery phrase of a SEPARATE, small test wallet holding a few dollars of USDC.
# NEVER put the phrase for your main ALGO wallet here.
BUYER_MNEMONIC=

# --- Subscriptions (Stripe). Start with a TEST key (sk_test_...). ---
STRIPE_SECRET_KEY=
# Filled in automatically by `npm run stripe:setup`:
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_WEBHOOK_SECRET=
# Shown to customers who lose their key
SUPPORT_EMAIL=
